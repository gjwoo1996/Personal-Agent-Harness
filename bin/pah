#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
VERSION="$(tr -d '\n' < "$ROOT/VERSION")"
RULE_DOMAINS_FILE="$ROOT/config/rule-domains.txt"
RULE_DOMAINS=()

usage() {
  cat <<'USAGE'
Usage:
  pah init <target> [--clean-nested]
  pah update <target>
  pah install <target> [--dry-run] [--force] [--components rules,devcontainer,gitignore,harness-dev,hooks]
  pah verify <target>
  pah status <target> [--harness-root <path>]
USAGE
}

log() {
  printf '%s\n' "$*"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

ensure_target() {
  local target="$1"
  [ -d "$target" ] || die "target directory does not exist: $target"
}

has_component() {
  local components="$1"
  local wanted="$2"
  case ",$components," in
    *",$wanted,"*) return 0 ;;
    *) return 1 ;;
  esac
}

validate_components() {
  local components="$1"
  local component
  local -a requested=()

  case "$components" in
    ""|,*|*,|*,,*) die "--components contains an empty component" ;;
  esac
  IFS=',' read -r -a requested <<< "$components"
  [ "${#requested[@]}" -gt 0 ] || die "--components requires at least one component"
  for component in "${requested[@]}"; do
    case "$component" in
      rules|devcontainer|gitignore|harness-dev|hooks) ;;
      "") die "--components contains an empty component" ;;
      *) die "unknown component: $component" ;;
    esac
  done
}

verify_file() {
  local file="$1"
  [ -f "$file" ] || die "missing required file: $file"
}

verify_contains() {
  local file="$1"
  local pattern="$2"
  grep -Fq "$pattern" "$file" || die "missing '$pattern' in $file"
}

file_mode() {
  local file="$1"
  if stat -c '%a' "$file" >/dev/null 2>&1; then
    stat -c '%a' "$file"
  else
    stat -f '%Lp' "$file"
  fi
}

load_rule_domains() {
  [ -f "$RULE_DOMAINS_FILE" ] || die "missing rule domain registry: $RULE_DOMAINS_FILE"

  RULE_DOMAINS=()
  local domain
  local seen=","
  while IFS= read -r domain || [ -n "$domain" ]; do
    domain="${domain%%#*}"
    domain="${domain#"${domain%%[![:space:]]*}"}"
    domain="${domain%"${domain##*[![:space:]]}"}"
    [ -n "$domain" ] || continue

    [[ "$domain" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid rule domain id: $domain"
    case "$seen" in
      *",$domain,"*) die "duplicate rule domain id: $domain" ;;
    esac
    seen="${seen}${domain},"
    RULE_DOMAINS+=("$domain")
  done < "$RULE_DOMAINS_FILE"

  [ "${#RULE_DOMAINS[@]}" -gt 0 ] || die "rule domain registry is empty: $RULE_DOMAINS_FILE"
}

require_rule_domain_source() {
  local domain="$1"
  verify_file "$ROOT/standards/$domain/$domain-standards.md"
  verify_file "$ROOT/standards/$domain/$domain-standards.ko.md"
  verify_file "$ROOT/templates/stubs/agent-blocks/$domain.md"
  verify_file "$ROOT/templates/stubs/cursor/$domain-standards.mdc"
  validate_managed_block "$ROOT/templates/stubs/agent-blocks/$domain.md" "$domain" required
  verify_contains "$ROOT/templates/stubs/cursor/$domain-standards.mdc" "docs/$domain/$domain-standards.md"
  if grep -Fq "$domain-standards.ko.md" "$ROOT/templates/stubs/agent-blocks/$domain.md" "$ROOT/templates/stubs/cursor/$domain-standards.mdc"; then
    die "AI stubs must not reference $domain-standards.ko.md as a rule source"
  fi
}

validate_managed_block() {
  local file="$1"
  local domain="$2"
  local presence="${3:-optional}"
  local start="<!-- pah:$domain:start -->"
  local end="<!-- pah:$domain:end -->"
  local start_count
  local end_count

  [ -f "$file" ] || {
    [ "$presence" = "required" ] && die "missing required file: $file"
    return 0
  }

  start_count="$(grep -Fc "$start" "$file" || true)"
  end_count="$(grep -Fc "$end" "$file" || true)"
  if [ "$presence" != "required" ] && [ "$start_count" = "0" ] && [ "$end_count" = "0" ]; then
    return 0
  fi
  [ "$start_count" = "1" ] || die "expected exactly one '$start' in $file"
  [ "$end_count" = "1" ] || die "expected exactly one '$end' in $file"

  awk -v start="$start" -v end="$end" '
    $0 == start { seen_start=1; next }
    $0 == end { seen_end=1; exit seen_start ? 0 : 1 }
    END { if (!seen_start || !seen_end) exit 1 }
  ' "$file" || die "managed block markers are out of order in $file"
}

preflight_rule_install() {
  local target="$1"
  local domain

  for domain in "${RULE_DOMAINS[@]}"; do
    require_rule_domain_source "$domain"
    validate_managed_block "$target/AGENTS.md" "$domain"
    validate_managed_block "$target/CLAUDE.md" "$domain"
  done
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

backup_file() {
  local target="$1"
  local rel="$2"
  local backup_dir="$3"
  [ -f "$target/$rel" ] || return 0
  [ -f "$backup_dir/$rel" ] && return 0
  mkdir -p "$backup_dir/$(dirname "$rel")"
  cp "$target/$rel" "$backup_dir/$rel"
}

copy_managed_file() {
  local src="$1"
  local target="$2"
  local rel="$3"
  local dry_run="$4"
  local force="$5"
  local backup_dir="$6"

  if [ "$dry_run" = "1" ]; then
    if [ -f "$target/$rel" ]; then
      log "[DRY-RUN] UPDATE  $rel"
    else
      log "[DRY-RUN] CREATE  $rel"
    fi
    return 0
  fi

  if [ -f "$target/$rel" ] && [ "$force" != "1" ]; then
    if cmp -s "$src" "$target/$rel"; then
      return 0
    fi
  fi

  backup_file "$target" "$rel" "$backup_dir"
  mkdir -p "$target/$(dirname "$rel")"
  cp "$src" "$target/$rel"
}

merge_agent_block() {
  local block_src="$1"
  local target="$2"
  local rel="$3"
  local title="$4"
  local domain="$5"
  local dry_run="$6"
  local backup_dir="$7"
  local dest="$target/$rel"
  local start="<!-- pah:$domain:start -->"
  local end="<!-- pah:$domain:end -->"

  if [ "$dry_run" = "1" ]; then
    if [ -f "$dest" ]; then
      log "[DRY-RUN] MERGE   $rel ($domain)"
    else
      log "[DRY-RUN] CREATE  $rel ($domain)"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  backup_file "$target" "$rel" "$backup_dir"
  validate_managed_block "$dest" "$domain"

  if [ ! -f "$dest" ]; then
    {
      printf '# %s\n\n' "$title"
      cat "$block_src"
    } > "$dest"
    chmod 644 "$dest"
    return 0
  fi

  local tmp
  tmp="$(mktemp "$dest.tmp.XXXXXX")"
  chmod "$(file_mode "$dest")" "$tmp"
  if grep -Fq "$start" "$dest"; then
    awk -v start="$start" -v end="$end" -v block_src="$block_src" '
      function print_block(   line) {
        while ((getline line < block_src) > 0) {
          print line
        }
        close(block_src)
      }
      $0 == start {
        print_block()
        skipping=1
        next
      }
      $0 == end {
        skipping=0
        next
      }
      !skipping { print }
    ' "$dest" > "$tmp"
  else
    {
      cat "$dest"
      printf '\n'
      cat "$block_src"
    } > "$tmp"
  fi
  mv "$tmp" "$dest"
}

install_rule_domain() {
  local domain="$1"
  local target="$2"
  local dry_run="$3"
  local force="$4"
  local backup_dir="$5"

  require_rule_domain_source "$domain"
  copy_managed_file "$ROOT/standards/$domain/$domain-standards.md" "$target" "docs/$domain/$domain-standards.md" "$dry_run" "$force" "$backup_dir"
  copy_managed_file "$ROOT/standards/$domain/$domain-standards.ko.md" "$target" "docs/$domain/$domain-standards.ko.md" "$dry_run" "$force" "$backup_dir"
  copy_managed_file "$ROOT/templates/stubs/cursor/$domain-standards.mdc" "$target" ".cursor/rules/$domain-standards.mdc" "$dry_run" "$force" "$backup_dir"
  merge_agent_block "$ROOT/templates/stubs/agent-blocks/$domain.md" "$target" "AGENTS.md" "Agent Instructions" "$domain" "$dry_run" "$backup_dir"
  merge_agent_block "$ROOT/templates/stubs/agent-blocks/$domain.md" "$target" "CLAUDE.md" "Claude Instructions" "$domain" "$dry_run" "$backup_dir"
}

generate_manifest_file() {
  local target="$1"
  local mode="$2"
  local output="$3"
  local domain
  local rel
  local first

  {
    printf '{\n'
    printf '  "harness": "Personal-Agent-Harness",\n'
    printf '  "harness_version": "%s",\n' "$VERSION"
    printf '  "mode": "%s",\n' "$mode"
    printf '  "standards": {\n'

    first=1
    for domain in "${RULE_DOMAINS[@]}"; do
      [ "$first" = "1" ] || printf ',\n'
      first=0
      printf '    "%s": {\n' "$domain"
      printf '      "en": {\n'
      printf '        "path": "docs/%s/%s-standards.md",\n' "$domain" "$domain"
      printf '        "sha256": "%s"\n' "$(sha256_file "$target/docs/$domain/$domain-standards.md")"
      printf '      },\n'
      printf '      "ko": {\n'
      printf '        "path": "docs/%s/%s-standards.ko.md",\n' "$domain" "$domain"
      printf '        "sha256": "%s",\n' "$(sha256_file "$target/docs/$domain/$domain-standards.ko.md")"
      printf '        "ai_readable": false\n'
      printf '      }\n'
      printf '    }'
    done

    printf '\n  },\n'
    printf '  "managed_files": [\n'
    first=1
    for domain in "${RULE_DOMAINS[@]}"; do
      for rel in \
        "docs/$domain/$domain-standards.md" \
        "docs/$domain/$domain-standards.ko.md" \
        ".cursor/rules/$domain-standards.mdc"; do
        [ "$first" = "1" ] || printf ',\n'
        first=0
        printf '    "%s"' "$rel"
      done
    done
    for rel in "AGENTS.md" "CLAUDE.md"; do
      [ "$first" = "1" ] || printf ',\n'
      first=0
      printf '    "%s"' "$rel"
    done
    for domain in "${RULE_DOMAINS[@]}"; do
      [ -f "$target/.harness/hooks/$domain.hook.sh" ] || continue
      [ "$first" = "1" ] || printf ',\n'
      first=0
      printf '    ".harness/hooks/%s.hook.sh"' "$domain"
    done
    printf '\n  ]\n'
    printf '}\n'
  } > "$output"
}

write_manifest() {
  local target="$1"
  local mode="$2"
  local dry_run="$3"
  local backup_dir="$4"
  [ "$dry_run" = "1" ] && return 0

  local manifest_dir="$target/.harness"
  local tmp
  mkdir -p "$manifest_dir"
  backup_file "$target" ".harness/manifest.json" "$backup_dir"
  tmp="$(mktemp "$manifest_dir/manifest.json.tmp.XXXXXX")"
  chmod 644 "$tmp"
  generate_manifest_file "$target" "$mode" "$tmp"

  mv "$tmp" "$manifest_dir/manifest.json"
}

install_gitignore_block() {
  local target="$1"
  local dry_run="$2"
  local backup_dir="$3"
  local rel=".gitignore"
  local dest="$target/$rel"
  local block
  block="$(cat <<'EOF'
# pah:managed:start
.env
.devcontainer/.env
.harness/backups/
Personal-Agent-Harness/
# pah:managed:end
EOF
)"

  if [ "$dry_run" = "1" ]; then
    log "[DRY-RUN] MERGE   $rel"
    return 0
  fi

  backup_file "$target" "$rel" "$backup_dir"
  if [ -f "$dest" ] && grep -Fq '# pah:managed:start' "$dest"; then
    local tmp
    tmp="$(mktemp "$dest.tmp.XXXXXX")"
    chmod "$(file_mode "$dest")" "$tmp"
    awk -v block="$block" '
      /# pah:managed:start/ {
        print block
        skipping=1
        next
      }
      /# pah:managed:end/ {
        skipping=0
        next
      }
      !skipping { print }
    ' "$dest" > "$tmp"
    mv "$tmp" "$dest"
  else
    {
      [ -f "$dest" ] && cat "$dest"
      printf '\n%s\n' "$block"
    } > "$dest"
    chmod 644 "$dest"
  fi
}

install_devcontainer_scaffold() {
  local target="$1"
  local dry_run="$2"
  local force="$3"
  local backup_dir="$4"
  local src_dir="$ROOT/templates/devcontainer"

  [ -d "$src_dir" ] || die "missing devcontainer template: $src_dir"

  while IFS= read -r src; do
    local rel="${src#$src_dir/}"
    local dest_rel=".devcontainer/$rel"
    if [ -f "$target/$dest_rel" ] && [ "$force" != "1" ]; then
      [ "$dry_run" = "1" ] && log "[DRY-RUN] SKIP    $dest_rel"
      continue
    fi
    copy_managed_file "$src" "$target" "$dest_rel" "$dry_run" "$force" "$backup_dir"
  done < <(find "$src_dir" -type f | sort)
}

jq_available() {
  command -v jq >/dev/null 2>&1
}

read_hook_matchers() {
  local hook_src="$1"
  grep '^# PAH_MATCHERS:' "$hook_src" | sed 's/^# PAH_MATCHERS:[[:space:]]*//'
}

merge_settings_json() {
  local target="$1"
  local backup_dir="$2"
  local settings_file="$target/.claude/settings.json"
  local domain
  local matchers
  local matcher
  local matcher_arr
  local pah_hooks='[]'

  for domain in "${RULE_DOMAINS[@]}"; do
    local hook_src="$ROOT/templates/stubs/hooks/$domain.hook.sh"
    [ -f "$hook_src" ] || continue
    matchers="$(read_hook_matchers "$hook_src")"
    [ -n "$matchers" ] || continue
    IFS=',' read -r -a matcher_arr <<< "$matchers"
    for matcher in "${matcher_arr[@]}"; do
      matcher="${matcher#"${matcher%%[![:space:]]*}"}"
      matcher="${matcher%"${matcher##*[![:space:]]}"}"
      [ -n "$matcher" ] || continue
      pah_hooks="$(printf '%s' "$pah_hooks" | jq \
        --arg m "$matcher" \
        --arg cmd "bash .harness/hooks/$domain.hook.sh" \
        '. + [{matcher: $m, hooks: [{type: "command", command: $cmd}]}]')"
    done
  done

  mkdir -p "$target/.claude"
  backup_file "$target" ".claude/settings.json" "$backup_dir"

  local tmp
  tmp="$(mktemp "${settings_file}.tmp.XXXXXX")"

  if [ ! -f "$settings_file" ]; then
    chmod 644 "$tmp"
    jq -n --argjson pah "$pah_hooks" \
      '{hooks: {PreToolUse: $pah}}' > "$tmp" \
      || { rm -f "$tmp"; die "failed to create .claude/settings.json"; }
  else
    chmod "$(file_mode "$settings_file")" "$tmp"
    jq \
      --argjson pah "$pah_hooks" \
      '.hooks.PreToolUse = (
        ((.hooks.PreToolUse // []) |
         map(
           .hooks = (.hooks | map(select(.command | startswith("bash .harness/hooks/") | not)))
         ) |
         map(select(.hooks | length > 0))
        ) + $pah
      )' \
      "$settings_file" > "$tmp" \
      || { rm -f "$tmp"; die "failed to merge .claude/settings.json"; }
  fi
  mv "$tmp" "$settings_file"
}

install_hooks_component() {
  local target="$1"
  local dry_run="$2"
  local force="$3"
  local backup_dir="$4"
  local domain

  if ! jq_available; then
    log "WARNING: jq not found — enforcement hooks skipped. Install jq to enable."
    return 0
  fi

  [ "${#RULE_DOMAINS[@]}" -gt 0 ] || load_rule_domains

  for domain in "${RULE_DOMAINS[@]}"; do
    local hook_src="$ROOT/templates/stubs/hooks/$domain.hook.sh"
    [ -f "$hook_src" ] || continue
    if [ "$dry_run" = "1" ]; then
      log "[DRY-RUN] CREATE  .harness/hooks/$domain.hook.sh"
      continue
    fi
    copy_managed_file "$hook_src" "$target" ".harness/hooks/$domain.hook.sh" "0" "$force" "$backup_dir"
    chmod +x "$target/.harness/hooks/$domain.hook.sh"
  done

  if [ "$dry_run" = "1" ]; then
    log "[DRY-RUN] MERGE   .claude/settings.json (hooks)"
    return 0
  fi

  merge_settings_json "$target" "$backup_dir"
}

verify_hooks_if_installed() {
  local target="$1"
  local domain
  local matcher
  local matcher_arr
  local matchers

  for domain in "${RULE_DOMAINS[@]}"; do
    [ -f "$target/.harness/hooks/$domain.hook.sh" ] || continue
    [ -x "$target/.harness/hooks/$domain.hook.sh" ] || die "hook script is not executable: $target/.harness/hooks/$domain.hook.sh"
    verify_file "$target/.claude/settings.json"
    if jq_available; then
      jq empty "$target/.claude/settings.json" >/dev/null || die "invalid JSON: $target/.claude/settings.json"
      matchers="$(read_hook_matchers "$ROOT/templates/stubs/hooks/$domain.hook.sh")"
      [ -n "$matchers" ] || die "missing PAH_MATCHERS for hook domain: $domain"
      IFS=',' read -r -a matcher_arr <<< "$matchers"
      for matcher in "${matcher_arr[@]}"; do
        matcher="${matcher#"${matcher%%[![:space:]]*}"}"
        matcher="${matcher%"${matcher##*[![:space:]]}"}"
        [ -n "$matcher" ] || continue
        jq -e \
          --arg m "$matcher" \
          --arg cmd "bash .harness/hooks/$domain.hook.sh" \
          '.hooks.PreToolUse // [] |
           any(.matcher == $m and ((.hooks // []) |
             any(.type == "command" and .command == $cmd)))' \
          "$target/.claude/settings.json" >/dev/null \
          || die "missing Claude PreToolUse hook for $domain matcher $matcher"
      done
    else
      verify_contains "$target/.claude/settings.json" ".harness/hooks/$domain.hook.sh"
    fi
  done
}

cmd_install() {
  local target="${1:-}"
  [ -n "$target" ] || die "install requires target"
  shift || true

  local dry_run=0
  local force=0
  local components="rules,hooks"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --force) force=1 ;;
      --components)
        shift
        components="${1:-}"
        [ -n "$components" ] || die "--components requires a value"
        ;;
      *) die "unknown install option: $1" ;;
    esac
    shift
  done

  validate_components "$components"
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  local backup_dir
  if has_component "$components" "rules"; then
    load_rule_domains
    preflight_rule_install "$target"
  fi
  if has_component "$components" "hooks"; then
    if ! has_component "$components" "rules"; then
      [ -f "$target/.harness/manifest.json" ] || die "hooks component requires rules component or an existing rules installation"
      [ "${#RULE_DOMAINS[@]}" -gt 0 ] || load_rule_domains
    fi
  fi

  if [ "$dry_run" = "1" ]; then
    backup_dir="$target/.harness/backups/dry-run"
    log "[DRY-RUN] Installing Personal-Agent-Harness into $target"
  else
    mkdir -p "$target/.harness/backups"
    backup_dir="$(mktemp -d "$target/.harness/backups/$(date +%Y%m%dT%H%M%S).XXXXXX")"
  fi

  if has_component "$components" "rules"; then
    for domain in "${RULE_DOMAINS[@]}"; do
      install_rule_domain "$domain" "$target" "$dry_run" "$force" "$backup_dir"
    done
  fi

  if has_component "$components" "devcontainer"; then
    install_devcontainer_scaffold "$target" "$dry_run" "$force" "$backup_dir"
  fi

  if has_component "$components" "gitignore"; then
    install_gitignore_block "$target" "$dry_run" "$backup_dir"
  fi

  if has_component "$components" "harness-dev"; then
    copy_managed_file "$ROOT/templates/harness-dev/harness-development.mdc" "$target" ".cursor/rules/harness-development.mdc" "$dry_run" "$force" "$backup_dir"
  fi

  if has_component "$components" "hooks"; then
    install_hooks_component "$target" "$dry_run" "$force" "$backup_dir"
  fi

  if has_component "$components" "rules" || has_component "$components" "hooks"; then
    write_manifest "$target" "copy" "$dry_run" "$backup_dir"
  fi
  [ "$dry_run" = "1" ] || log "Installed Personal-Agent-Harness into $target"
}

verify_rule_domain() {
  local domain="$1"
  local target="$2"
  local en_rel="docs/$domain/$domain-standards.md"
  local ko_rel="docs/$domain/$domain-standards.ko.md"
  local cursor_rel=".cursor/rules/$domain-standards.mdc"

  verify_file "$target/$en_rel"
  verify_file "$target/$ko_rel"
  verify_file "$target/$cursor_rel"
  validate_managed_block "$target/AGENTS.md" "$domain" required
  validate_managed_block "$target/CLAUDE.md" "$domain" required
  verify_agent_block_matches_source "$target/AGENTS.md" "$ROOT/templates/stubs/agent-blocks/$domain.md" "$domain"
  verify_agent_block_matches_source "$target/CLAUDE.md" "$ROOT/templates/stubs/agent-blocks/$domain.md" "$domain"
  verify_contains "$target/$cursor_rel" "$en_rel"

  if grep -Fq "$domain-standards.ko.md" "$target/$cursor_rel" "$target/AGENTS.md" "$target/CLAUDE.md"; then
    die "AI stubs must not reference $domain-standards.ko.md as a rule source"
  fi

}

extract_managed_block() {
  local file="$1"
  local domain="$2"
  local output="$3"
  local start="<!-- pah:$domain:start -->"
  local end="<!-- pah:$domain:end -->"

  awk -v start="$start" -v end="$end" '
    $0 == start { printing=1 }
    printing { print }
    $0 == end { exit }
  ' "$file" > "$output"
}

verify_agent_block_matches_source() {
  local target_file="$1"
  local source_file="$2"
  local domain="$3"
  local actual

  actual="$(mktemp)"
  extract_managed_block "$target_file" "$domain" "$actual"
  if ! cmp -s "$source_file" "$actual"; then
    rm -f "$actual"
    die "managed block drift detected for pah:$domain in $target_file"
  fi
  rm -f "$actual"
}

cmd_verify() {
  local target="${1:-}"
  [ -n "$target" ] || die "verify requires target"
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  verify_file "$target/.harness/manifest.json"
  verify_file "$target/AGENTS.md"
  verify_file "$target/CLAUDE.md"

  load_rule_domains
  for domain in "${RULE_DOMAINS[@]}"; do
    require_rule_domain_source "$domain"
    verify_rule_domain "$domain" "$target"
  done

  verify_hooks_if_installed "$target"

  local expected_manifest
  expected_manifest="$(mktemp)"
  generate_manifest_file "$target" "copy" "$expected_manifest"
  if ! cmp -s "$expected_manifest" "$target/.harness/manifest.json"; then
    rm -f "$expected_manifest"
    die "manifest does not match installed rule domains: $target/.harness/manifest.json"
  fi
  rm -f "$expected_manifest"

  log "Personal-Agent-Harness verification passed: $target"
}

warn_nested_harness() {
  local target="$1"
  if [ -d "$target/Personal-Agent-Harness/.git" ]; then
    log "WARNING: nested harness clone detected at $target/Personal-Agent-Harness"
    log "WARNING: recommended: pah init $target --clean-nested"
  fi
}

update_command_hint() {
  local target="$1"
  if [ "${PAH_DISTRIBUTION:-}" = "npm" ]; then
    log "update command: npx personal-agent-harness@latest update $target"
  else
    log "update command: $ROOT/update.sh $target"
  fi
}

cmd_init() {
  local target=""
  local clean_nested=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --clean-nested) clean_nested=1; shift ;;
      -h|--help|help) usage; exit 0 ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
          shift
        else
          die "unexpected init argument: $1"
        fi
        ;;
    esac
  done

  [ -n "$target" ] || target="."
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  warn_nested_harness "$target"
  "$ROOT/setup.sh" "$target"

  if [ "$clean_nested" = "1" ] && [ -d "$target/Personal-Agent-Harness" ]; then
    rm -rf "$target/Personal-Agent-Harness"
    log "Removed nested harness folder: $target/Personal-Agent-Harness"
  fi

  log "Harness rules installed into: $target"
  update_command_hint "$target"
}

cmd_update() {
  local target="${1:-.}"
  [ $# -le 1 ] || die "update accepts only an optional target path"
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  PAH_SKIP_PULL=1 "$ROOT/update.sh" "$target"
  update_command_hint "$target"
}

read_manifest_field() {
  local manifest="$1"
  local field="$2"

  if jq_available; then
    jq -r --arg field "$field" '.[$field]' "$manifest"
    return 0
  fi

  grep -E "\"$field\":" "$manifest" | head -1 | sed -E 's/.*: "([^"]*)".*/\1/'
}

cmd_status() {
  local target=""
  local harness_root=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --harness-root)
        [ $# -ge 2 ] || die "status --harness-root requires a path"
        harness_root="$2"
        shift 2
        ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
          shift
        else
          die "unexpected status argument: $1"
        fi
        ;;
    esac
  done

  [ -n "$target" ] || die "status requires target"
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  local manifest="$target/.harness/manifest.json"
  if [ ! -f "$manifest" ]; then
    log "Personal-Agent-Harness not installed: $target"
    return 0
  fi

  log "Personal-Agent-Harness installed: $target"
  log "Manifest: .harness/manifest.json"

  local installed_version
  installed_version="$(read_manifest_field "$manifest" "harness_version")"
  log "harness_version: $installed_version"

  warn_nested_harness "$target"

  local compare_root="${harness_root:-$ROOT}"
  compare_root="$(cd "$compare_root" && pwd -P)"
  local remote_version_file="$compare_root/VERSION"
  [ -f "$remote_version_file" ] || die "harness VERSION file not found: $remote_version_file"
  local available_version
  available_version="$(tr -d '\n' < "$remote_version_file")"
  log "cli version: $available_version"
  if [ "$installed_version" != "$available_version" ]; then
    log "update available: installed $installed_version, cli $available_version"
    if [ "${PAH_DISTRIBUTION:-}" = "npm" ]; then
      log "update command: npx personal-agent-harness@latest update $target"
    elif [ -n "$harness_root" ]; then
      log "update command: $compare_root/update.sh $target"
    else
      log "update command: $ROOT/update.sh $target"
    fi
  else
    log "up to date with cli"
  fi
}

main() {
  local command="${1:-}"
  [ -n "$command" ] || { usage; exit 1; }
  shift || true

  case "$command" in
    init) cmd_init "$@" ;;
    update) cmd_update "$@" ;;
    install) cmd_install "$@" ;;
    verify) cmd_verify "$@" ;;
    status) cmd_status "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
