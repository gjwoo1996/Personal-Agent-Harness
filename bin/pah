#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
VERSION="$(tr -d '\n' < "$ROOT/VERSION")"

usage() {
  cat <<'USAGE'
Usage:
  pah install <target> [--dry-run] [--force] [--components rules,devcontainer,gitignore,harness-dev]
  pah verify <target>
  pah status <target>
USAGE
}

log() {
  printf '%s\n' "$*"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

ensure_target() {
  local target="$1"
  [ -d "$target" ] || die "target directory does not exist: $target"
}

has_component() {
  local components="$1"
  local wanted="$2"
  case ",$components," in
    *",$wanted,"*) return 0 ;;
    *) return 1 ;;
  esac
}

sha256_file() {
  sha256sum "$1" | awk '{print $1}'
}

backup_file() {
  local target="$1"
  local rel="$2"
  local backup_dir="$3"
  [ -f "$target/$rel" ] || return 0
  mkdir -p "$backup_dir/$(dirname "$rel")"
  cp "$target/$rel" "$backup_dir/$rel"
}

copy_managed_file() {
  local src="$1"
  local target="$2"
  local rel="$3"
  local dry_run="$4"
  local force="$5"
  local backup_dir="$6"

  if [ "$dry_run" = "1" ]; then
    if [ -f "$target/$rel" ]; then
      log "[DRY-RUN] UPDATE  $rel"
    else
      log "[DRY-RUN] CREATE  $rel"
    fi
    return 0
  fi

  if [ -f "$target/$rel" ] && [ "$force" != "1" ]; then
    if cmp -s "$src" "$target/$rel"; then
      return 0
    fi
  fi

  backup_file "$target" "$rel" "$backup_dir"
  mkdir -p "$target/$(dirname "$rel")"
  cp "$src" "$target/$rel"
}

extract_block() {
  local src="$1"
  awk '/<!-- pah:devcontainer:start -->/{flag=1} flag{print} /<!-- pah:devcontainer:end -->/{flag=0}' "$src"
}

merge_stub_file() {
  local template="$1"
  local target="$2"
  local rel="$3"
  local title="$4"
  local dry_run="$5"
  local backup_dir="$6"
  local dest="$target/$rel"

  if [ "$dry_run" = "1" ]; then
    if [ -f "$dest" ]; then
      log "[DRY-RUN] MERGE   $rel"
    else
      log "[DRY-RUN] CREATE  $rel"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  backup_file "$target" "$rel" "$backup_dir"

  local block
  block="$(extract_block "$template")"

  if [ ! -f "$dest" ]; then
    {
      printf '# %s\n\n' "$title"
      printf '%s\n' "$block"
    } > "$dest"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  if grep -Fq '<!-- pah:devcontainer:start -->' "$dest"; then
    awk -v block="$block" '
      /<!-- pah:devcontainer:start -->/ {
        print block
        skipping=1
        next
      }
      /<!-- pah:devcontainer:end -->/ {
        skipping=0
        next
      }
      !skipping { print }
    ' "$dest" > "$tmp"
  else
    {
      cat "$dest"
      printf '\n%s\n' "$block"
    } > "$tmp"
  fi
  mv "$tmp" "$dest"
}

write_manifest() {
  local target="$1"
  local mode="$2"
  local dry_run="$3"
  [ "$dry_run" = "1" ] && return 0

  local manifest_dir="$target/.harness"
  mkdir -p "$manifest_dir"
  cat > "$manifest_dir/manifest.json" <<JSON
{
  "harness": "Personal-Agent-Harness",
  "harness_version": "$VERSION",
  "mode": "$mode",
  "standards": {
    "en": {
      "path": "docs/devcontainer/devcontainer-standards.md",
      "sha256": "$(sha256_file "$target/docs/devcontainer/devcontainer-standards.md")"
    },
    "ko": {
      "path": "docs/devcontainer/devcontainer-standards.ko.md",
      "sha256": "$(sha256_file "$target/docs/devcontainer/devcontainer-standards.ko.md")",
      "ai_readable": false
    }
  },
  "managed_files": [
    "docs/devcontainer/devcontainer-standards.md",
    "docs/devcontainer/devcontainer-standards.ko.md",
    ".cursor/rules/devcontainer-standards.mdc",
    "AGENTS.md",
    "CLAUDE.md"
  ]
}
JSON
}

install_gitignore_block() {
  local target="$1"
  local dry_run="$2"
  local backup_dir="$3"
  local rel=".gitignore"
  local dest="$target/$rel"
  local block
  block="$(cat <<'EOF'
# pah:managed:start
.env
.devcontainer/.env
.harness/backups/
# pah:managed:end
EOF
)"

  if [ "$dry_run" = "1" ]; then
    log "[DRY-RUN] MERGE   $rel"
    return 0
  fi

  backup_file "$target" "$rel" "$backup_dir"
  if [ -f "$dest" ] && grep -Fq '# pah:managed:start' "$dest"; then
    local tmp
    tmp="$(mktemp)"
    awk -v block="$block" '
      /# pah:managed:start/ {
        print block
        skipping=1
        next
      }
      /# pah:managed:end/ {
        skipping=0
        next
      }
      !skipping { print }
    ' "$dest" > "$tmp"
    mv "$tmp" "$dest"
  else
    {
      [ -f "$dest" ] && cat "$dest"
      printf '\n%s\n' "$block"
    } > "$dest"
  fi
}

install_devcontainer_scaffold() {
  local target="$1"
  local dry_run="$2"
  local force="$3"
  local backup_dir="$4"
  local src_dir="$ROOT/templates/devcontainer"

  [ -d "$src_dir" ] || die "missing devcontainer template: $src_dir"

  while IFS= read -r src; do
    local rel="${src#$src_dir/}"
    local dest_rel=".devcontainer/$rel"
    if [ -f "$target/$dest_rel" ] && [ "$force" != "1" ]; then
      [ "$dry_run" = "1" ] && log "[DRY-RUN] SKIP    $dest_rel"
      continue
    fi
    copy_managed_file "$src" "$target" "$dest_rel" "$dry_run" "$force" "$backup_dir"
  done < <(find "$src_dir" -type f | sort)
}

cmd_install() {
  local target="${1:-}"
  [ -n "$target" ] || die "install requires target"
  shift || true

  local dry_run=0
  local force=0
  local components="rules"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --force) force=1 ;;
      --components)
        shift
        components="${1:-}"
        [ -n "$components" ] || die "--components requires a value"
        ;;
      *) die "unknown install option: $1" ;;
    esac
    shift
  done

  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  local backup_dir="$target/.harness/backups/$(date +%Y%m%dT%H%M%S)"
  if [ "$dry_run" = "1" ]; then
    log "[DRY-RUN] Installing Personal-Agent-Harness into $target"
  else
    mkdir -p "$backup_dir"
  fi

  if has_component "$components" "rules"; then
    copy_managed_file "$ROOT/standards/devcontainer/devcontainer-standards.md" "$target" "docs/devcontainer/devcontainer-standards.md" "$dry_run" "$force" "$backup_dir"
    copy_managed_file "$ROOT/standards/devcontainer/devcontainer-standards.ko.md" "$target" "docs/devcontainer/devcontainer-standards.ko.md" "$dry_run" "$force" "$backup_dir"
    copy_managed_file "$ROOT/templates/stubs/cursor/devcontainer-standards.mdc" "$target" ".cursor/rules/devcontainer-standards.mdc" "$dry_run" "$force" "$backup_dir"
    merge_stub_file "$ROOT/templates/stubs/AGENTS.md" "$target" "AGENTS.md" "Agent Instructions" "$dry_run" "$backup_dir"
    merge_stub_file "$ROOT/templates/stubs/CLAUDE.md" "$target" "CLAUDE.md" "Claude Instructions" "$dry_run" "$backup_dir"
  fi

  if has_component "$components" "devcontainer"; then
    install_devcontainer_scaffold "$target" "$dry_run" "$force" "$backup_dir"
  fi

  if has_component "$components" "gitignore"; then
    install_gitignore_block "$target" "$dry_run" "$backup_dir"
  fi

  if has_component "$components" "harness-dev"; then
    copy_managed_file "$ROOT/templates/harness-dev/harness-development.mdc" "$target" ".cursor/rules/harness-development.mdc" "$dry_run" "$force" "$backup_dir"
  fi

  if has_component "$components" "rules"; then
    write_manifest "$target" "copy" "$dry_run"
  fi
  [ "$dry_run" = "1" ] || log "Installed Personal-Agent-Harness into $target"
}

verify_file() {
  local file="$1"
  [ -f "$file" ] || die "missing required file: $file"
}

verify_contains() {
  local file="$1"
  local pattern="$2"
  grep -Fq "$pattern" "$file" || die "missing '$pattern' in $file"
}

cmd_verify() {
  local target="${1:-}"
  [ -n "$target" ] || die "verify requires target"
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  verify_file "$target/.harness/manifest.json"
  verify_file "$target/docs/devcontainer/devcontainer-standards.md"
  verify_file "$target/docs/devcontainer/devcontainer-standards.ko.md"
  verify_file "$target/.cursor/rules/devcontainer-standards.mdc"
  verify_file "$target/AGENTS.md"
  verify_file "$target/CLAUDE.md"

  verify_contains "$target/.cursor/rules/devcontainer-standards.mdc" "docs/devcontainer/devcontainer-standards.md"
  verify_contains "$target/AGENTS.md" "<!-- pah:devcontainer:start -->"
  verify_contains "$target/CLAUDE.md" "<!-- pah:devcontainer:start -->"

  if grep -Fq "devcontainer-standards.ko.md" "$target/.cursor/rules/devcontainer-standards.mdc" "$target/AGENTS.md" "$target/CLAUDE.md"; then
    die "AI stubs must not reference devcontainer-standards.ko.md as a rule source"
  fi

  log "Personal-Agent-Harness verification passed: $target"
}

cmd_status() {
  local target="${1:-}"
  [ -n "$target" ] || die "status requires target"
  target="$(cd "$target" && pwd -P)"
  ensure_target "$target"

  if [ -f "$target/.harness/manifest.json" ]; then
    log "Personal-Agent-Harness installed: $target"
    log "Manifest: .harness/manifest.json"
  else
    log "Personal-Agent-Harness not installed: $target"
  fi
}

main() {
  local command="${1:-}"
  [ -n "$command" ] || { usage; exit 1; }
  shift || true

  case "$command" in
    install) cmd_install "$@" ;;
    verify) cmd_verify "$@" ;;
    status) cmd_status "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
